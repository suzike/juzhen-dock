{
  "name": "juzhen-dock",
  "productName": "聚珍",
  "version": "0.7.1",
  "description": "聚珍 · 桌面入口，一触即达",
  "main": "main.js",
  "author": "juzhen",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.juzhen.dock",
    "productName": "聚珍",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ai.js",
      "term.js",
      "kb.js",
      "zones.js",
      "app/**/*",
      "icon.png",
      "tray.png",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "聚珍-${version}-便携版.exe"
    },
    "portable": {
      "artifactName": "聚珍-${version}-便携版.exe"
    },
    "compression": "maximum"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5"
  }
}
